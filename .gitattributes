# Normaliza o fim de linha nos arquivos de texto do repositório.
* text=auto

# Scripts do Windows precisam de CRLF para rodar sem problemas no cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Scripts Unix (Gradle wrapper) precisam de LF.
*.sh text eol=lf
gradlew text eol=lf

# Binários: o Git não deve tentar tratar como texto.
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.apk binary
